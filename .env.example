# ecoGPT — environment variables
#
# Copy this file to `.env` and fill in your real keys:
#   cp .env.example .env
#
# .env is gitignored. Never commit it.
#
# Each model in config.yaml declares which env var to read via
# `api_key_env`. Both models can share the same env var name if they
# live on the same provider.

# Small model API key (e.g. for vLLM, LM Studio, Together, Groq, etc.)
SMALL_MODEL_API_KEY=sk-replace-me

# Large model API key
LARGE_MODEL_API_KEY=sk-replace-me
